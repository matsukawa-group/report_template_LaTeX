%%% 通常の本文ページスタイル %%%
% 柱（節の番号と見出し）をページ上部の左に，ノンブルをページ下部の中央に表示
% 柱は節の見出しと同じく，番号も含めてサンセリフ体（ゴシック体）にする
\NewPageStyle{normal}{
  running_head_position=top-left,   % 柱の位置
  nombre_position=bottom-center,        % ノンブルの位置
  mark_format={_section=
    \underline{{\rule[-5pt]{0pt}{14pt}\hbox to \columnwidth{\sffamily\bfseries\thesection\quad#1\hfill}}}
    },        % 柱の書式（節の番号と見出しに下線を付ける）
  nombre={---\ \thepage\ ---}, % ノンブルの内容
  odd_running_head=_section,        % 奇数ページの柱
  even_running_head=_section        % 偶数ページの柱
}
\pagestyle{normal}

%%% 最初のページスタイル %%%
