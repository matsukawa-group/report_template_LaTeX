%==================================================
% 著者情報
%==================================================

\newcounter{authorcount}

\newcommand{\authors}{}
\newcommand{\pendingauthor}{}

%------------------------------------------
% 著者を追加
%------------------------------------------

\newcommand{\addauthor}[3]{%
  \stepcounter{authorcount}%

  \ifodd\value{authorcount}
    % 奇数人目：
    % 次の著者が来るまで保留
    \gdef\pendingauthor{{#1}{#2}{#3}}%
  \else
    % 偶数人目：
    % 保留中の著者と組にして authors に追加
    \expandafter\AddAuthorPair\pendingauthor{#1}{#2}{#3}%
    \gdef\pendingauthor{}%
  \fi
}

%------------------------------------------
% 2人を1行として authors に追加
%------------------------------------------

\newcommand{\AddAuthorPair}[6]{%
  \gappto{\authors}{%
    \AuthorBlock{#1}{#2}{#3}%
    &
    \AuthorBlock{#4}{#5}{#6}%
    \\[5em]%
  }%
}

%------------------------------------------
% 各著者の表示形式
%------------------------------------------

\newcommand{\AuthorBlock}[3]{%
  \begin{minipage}[t]{0.45\textwidth}
    \centering
    #1\par
    \vspace{0.5em}
    #2\par
    \vspace{0.5em}
    \href{mailto:#3}{#3}
  \end{minipage}%
}

%------------------------------------------
% 著者情報の出力
%------------------------------------------

\newcommand{\printauthors}{%
  \ifnum\value{authorcount}=1

    % 1 人の場合
    \expandafter\AuthorBlock\pendingauthor

  \else

    \begin{tabularx}{\textwidth}{
      >{\centering\arraybackslash}X
      >{\centering\arraybackslash}X
    }

      % 2 人組になっている著者
      \authors

      % 奇数人数なら最後の 1 人を中央に配置
      \ifodd\value{authorcount}
        \multicolumn{2}{c}{%
          \expandafter\AuthorBlock\pendingauthor
        }%
      \fi

    \end{tabularx}

  \fi
}

%==================================================
% 表紙
%==================================================

\definecolor{titleblue}{HTML}{1F4E79}

\newcommand{\makecover}{%
  \begin{titlepage}
    \thispagestyle{empty}

    \vspace*{\fill}

    \begin{center}

      {\color{titleblue}\rule{\textwidth}{2pt}}
      \\\vspace{-1.4em}
      {\color{titleblue}\rule{\textwidth}{1pt}}
      \\\vspace{0.7em}
      {\LARGE\bfseries
        \DocTitle
        \par
      }
      \vspace{0.7em}
      {\color{titleblue}\rule{\textwidth}{1pt}}
      \\\vspace{-1.3em}
      {\color{titleblue}\rule{\textwidth}{2pt}}

      \vspace{10em}

      %------------------------------------------
      % 著者
      %------------------------------------------

      {\fontsize{14pt}{16pt}\selectfont
        \printauthors
      }

      \vspace{15em}

      {\large \DocDate}

    \end{center}

    \vspace*{\fill}

  \end{titlepage}

  % 本文を 1 ページから開始
  \setcounter{page}{1}
}

%==================================================
% 表紙なしの場合のタイトル
%==================================================

\newcommand{\makeinlineauthor}{%
  \begin{center}

    {\LARGE\bfseries
      \DocTitle
      \par
    }

    \vspace{2em}

      {\fontsize{14pt}{16pt}\selectfont
        \printauthors
      }

    \vspace{1em}

    \DocDate

  \end{center}

  \vspace{3em}
}

%==================================================
% タイトル・著者情報を出力
%==================================================

\newcommand{\makedocumenttitle}{%
  \ifcover
    \makecover
  \else
    \makeinlineauthor
  \fi
}


