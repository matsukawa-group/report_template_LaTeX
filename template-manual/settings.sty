%%% ページスタイル（柱・ノンブル）の設定 %%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%% 通常の本文ページスタイル %%%
% 柱とノンブルをそれぞれページ上部の左右に表示
% ページ下部は何も表示しない
\NewPageStyle{normal}{
  running_head_position=top-left,   % 柱の位置
  nombre_position=bottom-center,        % ノンブルの位置
  mark_format={_section=
    \underline{{\rule[-5pt]{0pt}{14pt}\hbox to \columnwidth{\bfseries\thesection\quad#1\hfill}}}
    },        % 奇数ページの柱
  nombre={\thepage/\pageref{LastPage}}, % ノンブルの内容
  odd_running_head=_section,        % 奇数ページの柱
  even_running_head=_section        % 偶数ページの柱
}
\pagestyle{normal}

%%% 最初のページスタイル %%%
% 柱は表示しない
\NewPageStyle{cover}{
  nombre_position=bottom-center,        % ノンブルの位置
  nombre={\thepage/\pageref{LastPage}} % ノンブルの内容
}

